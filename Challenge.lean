module

public import Mathlib

@[expose] public section

/-!
# Weak and strong βη-normalization in pure type systems with βη-conversion

## Setting

A pure type system (PTS) is given by a specification `P : Specification S`.
It consists of a type `S` of sorts, a relation `P.axioms` and a relation `P.rule`.
`P.axioms s t` says that `s : t` is an axiom, and `P.rule s₁ s₂ s₃` says that `(s₁, s₂, s₃)` is a product rule.
The results hold for every specification.
In particular, the axiom and rule relations need not be functional, `S` and the relations may be infinite, and nothing needs to be decidable.

Pseudo-terms are variables, sorts, applications `F a`, abstractions `λx:A. b` and products `Πx:A. B`.
Variables are written as de Bruijn indices, and contexts are lists with the newest declaration first.

`Beta` is one-step β-reduction, which takes `(λx:A. b) a` to `b[x := a]`.
`Eta`  is one-step η-reduction, which takes `λx:A. F x` to `F` when `x` is not free in `F`.
Both act on pseudo-terms without any typing side condition.
In particular, an η-step discards the annotation `A` without comparing it to anything.
Both relations are closed under every term former, so a step may take place anywhere in a term.
This includes either part of an application, the body of a `λ` or `Π`, and the domain annotation `A` of `λx:A` or `Πx:A`.
`BetaEta` is a single step of either kind, and βη-conversion `ConvertsBE` is the equivalence relation generated by `BetaEta`.

`HasTypeBE P Γ M A` is the judgment `Γ ⊢ M : A` of the system `PTS_βη` in the sense of Geuvers (*Logics and Type Systems*, 1993).
It has the usual seven PTS rules, and its conversion rule uses βη-conversion `ConvertsBE`.
A context is valid when each declaration has a sort as its type in the part of the context before it.
A term `M` is legal in a valid context `Γ` when `Γ ⊢ M : A` or `Γ ⊢ A : M` for some `A`.

## Main results

* `weak_implies_strong_betaEta`:      if every legal term of a `PTS_βη` is weakly βη-normalizing, then every legal term is strongly βη-normalizing.
* `weak_beta_implies_strong_betaEta`: if every legal term of a `PTS_βη` is weakly β-normalizing,  then every legal term is strongly βη-normalizing.

The first result is the βη version, for `PTS_βη`, of the Barendregt–Geuvers–Klop conjecture "weak normalization implies strong normalization".
Geuvers states the conjecture for all pure type systems (*Logics and Type Systems*, 1993, Conjecture 8.1.2).
The name follows OpenAI's preprint *Weak and strong normalization in pure type systems*, which proves the β version for `PTS_β`.

A term is strongly normalizing when every reduction sequence from it is finite, which is stated as accessibility for the converse of one-step reduction.
Since steps may occur inside domain annotations, these sequences include reductions inside annotations.
-/

namespace PureTypeSystem

universe u

/-- PTS pseudo-terms over a type of sorts, written with de Bruijn indices.
`lam A b` stands for `λx:A. b` and `pi A B` stands for `Πx:A. B`.
Inside `b` and `B`, the index `0` refers to the bound variable `x`. -/
inductive Expr (Sorts : Type u) : Type u
  | var : Nat → Expr Sorts
  | sort : Sorts → Expr Sorts
  | app : Expr Sorts → Expr Sorts → Expr Sorts
  | lam : Expr Sorts → Expr Sorts → Expr Sorts
  | pi : Expr Sorts → Expr Sorts → Expr Sorts
  deriving DecidableEq

namespace Expr

variable {S : Type u}

/-- Lifts a renaming under one binder.
Index `0` is the new bound variable and stays fixed.
Every other index is renamed by `ρ` and then shifted up by one. -/
def liftRen (ρ : Nat → Nat) : Nat → Nat
  | 0 => 0
  | n + 1 => ρ n + 1

/-- Applies the renaming `ρ` to the free de Bruijn indices of a term.
Under each binder the renaming is lifted with `liftRen`, so bound variables are left alone. -/
def rename (ρ : Nat → Nat) : Expr S → Expr S
  | var n => var (ρ n)
  | sort s => sort s
  | app f a => app (rename ρ f) (rename ρ a)
  | lam A b => lam (rename ρ A) (rename (liftRen ρ) b)
  | pi A B => pi (rename ρ A) (rename (liftRen ρ) B)

/-- Lifts a substitution under one binder.
Index `0` is the new bound variable and stays fixed.
Every other index `n + 1` is replaced by `σ n`, with the free indices of `σ n` shifted up by one. -/
def liftSub (σ : Nat → Expr S) : Nat → Expr S
  | 0 => var 0
  | n + 1 => rename Nat.succ (σ n)

/-- Applies the simultaneous substitution `σ`, which replaces each free index `n` by `σ n`.
Under each binder the substitution is lifted with `liftSub`. -/
def subst (σ : Nat → Expr S) : Expr S → Expr S
  | var n => σ n
  | sort s => sort s
  | app f a => app (subst σ f) (subst σ a)
  | lam A b => lam (subst σ A) (subst (liftSub σ) b)
  | pi A B => pi (subst σ A) (subst (liftSub σ) B)

/-- The substitution that replaces index `0` by `a` and lowers every other index by one. -/
def single (a : Expr S) : Nat → Expr S
  | 0 => a
  | n + 1 => var n

/-- `b.instantiate a` is `b[x := a]`, where `b` is the body of a binder and `x` is its bound variable.
It replaces index `0` by `a` and lowers the other free indices of `b` by one, since the binder is removed. -/
def instantiate (b a : Expr S) : Expr S := subst (single a) b

end Expr

/-- A PTS specification over the sorts `S`.
`axioms s t` says that `s : t` is an axiom, and `rule s₁ s₂ s₃` says that `(s₁, s₂, s₃)` is a product rule. -/
structure Specification (S : Type u) where
  axioms : S → S → Prop
  rule : S → S → S → Prop

/-- One-step β-reduction.
The rule `head` takes `(λx:A. b) a` to `b[x := a]`.
The other rules allow the step inside any subterm, including the domains of `λ` and `Π`. -/
inductive Beta {S : Type u} : Expr S → Expr S → Prop
  | head (A b a) : Beta (.app (.lam A b) a) (b.instantiate a)
  | app_left {f f' a} : Beta f f' → Beta (.app f a) (.app f' a)
  | app_right {f a a'} : Beta a a' → Beta (.app f a) (.app f a')
  | lam_domain {A A' b} : Beta A A' → Beta (.lam A b) (.lam A' b)
  | lam_body {A b b'} : Beta b b' → Beta (.lam A b) (.lam A b')
  | pi_domain {A A' B} : Beta A A' → Beta (.pi A B) (.pi A' B)
  | pi_body {A B B'} : Beta B B' → Beta (.pi A B) (.pi A B')

/-- A term is β-normal when no β-step applies to it. -/
def Normal {S : Type u} (M : Expr S) : Prop := ∀ N, ¬ Beta M N

/-- A term is weakly β-normalizing when some β-reduction sequence from it ends in a β-normal term. -/
def WeaklyNormalizing {S : Type u} (M : Expr S) : Prop :=
  ∃ N, Relation.ReflTransGen Beta M N ∧ Normal N

variable {S : Type u}

open Relation

/-- One-step η-reduction.
The rule `head` takes `λx:A. F x` to `F` when `x` is not free in `F`.
In de Bruijn form, this condition says that the function part of the body is `F` with its free indices shifted up by one.
The rule has no typing side condition, and `A` is arbitrary.
The other rules allow the step inside any subterm, including the domains of `λ` and `Π`. -/
inductive Eta : Expr S → Expr S → Prop
  | head (A F : Expr S) : Eta (.lam A (.app (F.rename Nat.succ) (.var 0))) F
  | app_left {f f' a} : Eta f f' → Eta (.app f a) (.app f' a)
  | app_right {f a a'} : Eta a a' → Eta (.app f a) (.app f a')
  | lam_domain {A A' b} : Eta A A' → Eta (.lam A b) (.lam A' b)
  | lam_body {A b b'} : Eta b b' → Eta (.lam A b) (.lam A b')
  | pi_domain {A A' B} : Eta A A' → Eta (.pi A B) (.pi A' B)
  | pi_body {A B B'} : Eta B B' → Eta (.pi A B) (.pi A B')

/-- One-step βη-reduction, which is either a β-step or an η-step. -/
def BetaEta (M N : Expr S) : Prop := Beta M N ∨ Eta M N

/-- A term is strongly βη-normalizing when every βη-reduction sequence from it is finite.
This is stated as accessibility for the converse of `BetaEta`. -/
def StronglyNormalizingBetaEta (M : Expr S) : Prop :=
  Acc (fun N M : Expr S => BetaEta M N) M

/-- βη-conversion, the equivalence relation generated by `BetaEta`. -/
def ConvertsBE (M N : Expr S) : Prop := EqvGen BetaEta M N

/-- Typing in the system `PTS_βη` given by `P`.
`HasTypeBE P Γ M A` is the judgment `Γ ⊢ M : A`.
The seven rules are the usual PTS rules, and the conversion rule uses βη-conversion `ConvertsBE`.
Contexts list the newest declaration first, so the rules `var` and `weaken` shift indices by one. -/
inductive HasTypeBE {S : Type u} (P : Specification S) :
    List (Expr S) → Expr S → Expr S → Prop
  | ax {s t} : P.axioms s t → HasTypeBE P [] (.sort s) (.sort t)
  | var {Γ A s} : HasTypeBE P Γ A (.sort s) →
      HasTypeBE P (A :: Γ) (.var 0) (A.rename Nat.succ)
  | weaken {Γ M B A s} : HasTypeBE P Γ M B → HasTypeBE P Γ A (.sort s) →
      HasTypeBE P (A :: Γ) (M.rename Nat.succ) (B.rename Nat.succ)
  | product {Γ A B s₁ s₂ s₃} : HasTypeBE P Γ A (.sort s₁) →
      HasTypeBE P (A :: Γ) B (.sort s₂) → P.rule s₁ s₂ s₃ →
      HasTypeBE P Γ (.pi A B) (.sort s₃)
  | abstraction {Γ A b B s} : HasTypeBE P (A :: Γ) b B →
      HasTypeBE P Γ (.pi A B) (.sort s) →
      HasTypeBE P Γ (.lam A b) (.pi A B)
  | application {Γ f a A B} : HasTypeBE P Γ f (.pi A B) →
      HasTypeBE P Γ a A → HasTypeBE P Γ (.app f a) (B.instantiate a)
  | conversion {Γ M A B s} : HasTypeBE P Γ M A → HasTypeBE P Γ B (.sort s) →
      ConvertsBE A B → HasTypeBE P Γ M B

/-- A context is valid in the system `PTS_βη` given by `P` when each declaration has a sort as its
type in the part of the context before it. -/
inductive ValidContextBE {S : Type u} (P : Specification S) : List (Expr S) → Prop
  | nil : ValidContextBE P []
  | cons {Γ A s} : ValidContextBE P Γ → HasTypeBE P Γ A (.sort s) →
      ValidContextBE P (A :: Γ)

/-- A term `M` is legal in `Γ` when it has a type in `Γ` or is the type of some term in `Γ`. -/
def LegalBE (P : Specification S) (Γ : List (Expr S)) (M : Expr S) : Prop :=
  ∃ A, HasTypeBE P Γ M A ∨ HasTypeBE P Γ A M

/-- A term is βη-normal when no βη-step applies to it. -/
def NormalBE (M : Expr S) : Prop := ∀ N, ¬ BetaEta M N

/-- A term is weakly βη-normalizing when some βη-reduction sequence from it ends in a βη-normal
term. -/
def WeaklyNormalizingBE (M : Expr S) : Prop :=
  ∃ N, ReflTransGen BetaEta M N ∧ NormalBE N

/-- The system `PTS_βη` given by `P` is weakly βη-normalizing when every legal term in every valid
context is weakly βη-normalizing. -/
def SystemWeaklyNormalizingBE (P : Specification S) : Prop :=
  ∀ Γ, ValidContextBE P Γ → ∀ M, LegalBE P Γ M → WeaklyNormalizingBE M

/-- The system `PTS_βη` given by `P` is strongly βη-normalizing when every legal term in every valid
context is strongly βη-normalizing. -/
def SystemStronglyNormalizingBE (P : Specification S) : Prop :=
  ∀ Γ, ValidContextBE P Γ → ∀ M, LegalBE P Γ M → StronglyNormalizingBetaEta M

/-- **Weak βη-normalization implies strong βη-normalization.**
For every PTS specification `P`, if every legal term of `PTS_βη` is weakly βη-normalizing, then
every legal term is strongly βη-normalizing.
No assumption is made on the sorts, axioms or rules.
This is the βη version of the Barendregt–Geuvers–Klop conjecture for `PTS_βη`. -/
theorem weak_implies_strong_betaEta (P : Specification S)
    (h : SystemWeaklyNormalizingBE P) : SystemStronglyNormalizingBE P := by
  sorry

/-- **Weak β-normalization implies strong βη-normalization.**
For every PTS specification `P`, if every legal term of `PTS_βη` has a β-normal form, then every
legal term is strongly βη-normalizing.
The hypothesis uses `WeaklyNormalizing`, which concerns β-reduction only. -/
theorem weak_beta_implies_strong_betaEta (P : Specification S)
    (h : ∀ Γ, ValidContextBE P Γ → ∀ M, LegalBE P Γ M → WeaklyNormalizing M) :
    SystemStronglyNormalizingBE P := by
  sorry

end PureTypeSystem
